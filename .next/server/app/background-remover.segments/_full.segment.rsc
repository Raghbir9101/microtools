c:["$","$L14",null,{"faqs":[{"question":"What will the Background Remover do?","answer":"The tool will automatically detect and remove the background from your photo — replacing it with white, transparent, or a custom colour. Ideal for passport photos, govt ID cards, and professional profile pictures."},{"question":"Will it work for Indian passport-size photos?","answer":"Yes. We are specifically designing it to handle the Indian passport photo standard (35×45mm, white background) and government ID photo requirements."},{"question":"Will it require any app install or sign-up?","answer":"No. Like all Microtools, the Background Remover will run entirely in your browser with no account needed."},{"question":"When will it be available?","answer":"We are actively building it. Check back soon or use our image compressor tools in the meantime."}],"title":"About Background Remover"}]
